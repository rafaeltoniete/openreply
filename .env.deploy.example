# ─────────────────────────────────────────────────────────────────────────────
# openreply — variáveis do deploy (Docker Swarm). Copie para `.env.prod` NA VPS
# (fora do git) e preencha. O `docker stack deploy` NÃO lê env_file: exporte
# antes de subir —  set -a; . ./.env.prod; set +a
# ─────────────────────────────────────────────────────────────────────────────

# Tag da imagem no ghcr (a mesma que você deu de `git tag`).
# ⚠️ NÃO use v1: aquela tag foi buildada arm64, antes da correção, e neste servidor
#    dá "exec format error". A primeira imagem amd64 é a v2.
OPENREPLY_VERSION=v2

# Domínio público. É o que o Traefik roteia, o que vira NEXTAUTH_URL e o que o
# Meta precisa conhecer (OAuth redirect + webhook). Registro A no Cloudflare
# apontando para a VPS, **DNS only** (nuvem cinza) — o proxy da Cloudflare
# atrapalha o webhook do Meta.
OPENREPLY_HOST=openreply.zapin.pro

# ── Segredos do app ──────────────────────────────────────────────────────────
# Gere cada um com:  openssl rand -hex 32
NEXTAUTH_SECRET=
CRON_SECRET=
# ENCRYPTION_KEY criptografa os tokens do Instagram no banco. TEM que ser
# exatamente 64 caracteres hex. Se você trocar depois, todo token já salvo vira
# lixo e as contas precisam ser reconectadas.
ENCRYPTION_KEY=

# ── Banco ────────────────────────────────────────────────────────────────────
# Usa o Postgres que já roda na stack (serviço `postgres15`, rede `zapinpro`),
# num banco DEDICADO chamado `openreply` — o Prisma é dono do schema `public`
# dele, então não dá para dividir banco com outro app (ver DEPLOY.md §2).
DATABASE_URL=postgresql://USUARIO:SENHA@postgres15:5432/openreply

# ── E-mail (login por magic link) ────────────────────────────────────────────
# Sem isto NINGUÉM entra no painel, nem você: o login é só por link no e-mail.
# Escolha UM dos dois caminhos.
#
# (a) Resend — o caminho escolhido. Crie a API key em resend.com/api-keys.
#     Deixe EMAIL_SERVER vazio: se ele estiver preenchido, ganha do Resend.
RESEND_API_KEY=
#
# (b) SMTP próprio. NÃO é só o host: é uma URL de conexão completa, com usuário,
#     senha, host e porta. Zoho ficaria assim (465 = TLS implícito → `smtps://`;
#     587 = STARTTLS → `smtp://`):
#       smtps://rafael%40zapin.pro:SENHA@smtp.zoho.com:465
#     O usuário é o e-mail inteiro, e o `@` dele vira %40 (a URL já usa `@` como
#     separador). Com 2FA ligada, a senha tem que ser uma senha de aplicativo do
#     Zoho, não a da conta. E o EMAIL_FROM precisa ser a MESMA caixa autenticada
#     — o Zoho recusa envio com remetente diferente.
EMAIL_SERVER=

# Remetente.
# No Resend o domínio do EMAIL_FROM precisa estar verificado lá (registros DNS no
# Cloudflare). Enquanto não verificar `zapin.pro`, use o remetente de teste:
#   EMAIL_FROM=OpenReply <onboarding@resend.dev>
# Ele só entrega para o e-mail do dono da conta do Resend — o que basta aqui,
# já que ALLOWED_EMAILS tem só você. Para convidar outra pessoa depois, aí sim
# precisa verificar o domínio.
EMAIL_FROM=OpenReply <onboarding@resend.dev>

# ⚠️ TRAVA DE CADASTRO — preencha. Sem isto, qualquer pessoa que abrir o seu
# domínio pede um magic link, entra e ganha um workspace próprio. Lista separada
# por vírgula, sem espaços obrigatórios.
ALLOWED_EMAILS=rafaeltoniete@gmail.com

# ── Meta / Instagram ─────────────────────────────────────────────────────────
# Mesmo app do Meta que o dm-zapin já usa (fluxo "Instagram API with Instagram
# Login"): só acrescente o redirect e o webhook novos no painel do Meta.
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# O código tenta os dois segredos ao validar a assinatura do webhook, então
# preencher os dois evita o 401 silencioso de assinatura inválida.
FACEBOOK_APP_SECRET=
# Você inventa este valor e repete igual no painel do Meta → Webhooks.
WEBHOOK_VERIFY_TOKEN=
